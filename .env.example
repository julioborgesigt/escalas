# Escalas - Variáveis de Ambiente

# ============================================================================
# BANCO DE DADOS (Cloudflare D1)
# ============================================================================
# Configurado automaticamente pelo wrangler.toml
# Nenhuma variável necessária — use: wrangler d1 execute escalas-db

# ============================================================================
# STORAGE (Cloudflare R2)
# ============================================================================
# Configurado automaticamente pelo wrangler.toml
# Nenhuma variável necessária — use: npx wrangler r2 client escalas-docs

# ============================================================================
# AUTENTICAÇÃO
# ============================================================================

# Admin Geral (bootstrap)
# Usado para criar/autenticar o primeiro administrador geral
# ⚠️ Altere estes valores em produção!
ADMIN_GERAL_LOGIN=admin
ADMIN_GERAL_SENHA=seu-segredo-super-forte-aqui-mude-isto

# Webhook Sync (para integração com RH/Google Sheets)
# Token Bearer para autorizar requisições em /api/webhook/*
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SYNC_TOKEN=seu-token-aleatorio-de-32-bytes-em-hex

# ============================================================================
# EMAIL (para 2FA, redefinição de senha, notificações)
# ============================================================================

# Provider SMTP
SMTP_HOST=smtp.seu-provedor.com
SMTP_PORT=587
SMTP_USER=seu-usuario@seu-dominio.com
SMTP_PASSWORD=sua-senha-ou-token-app

# Remetente (From)
SMTP_FROM=noreply@seu-dominio.com
SMTP_FROM_NAME=Escalas

# Para testes locais, você pode usar:
# SMTP_HOST=localhost
# SMTP_PORT=1025
# (e rodar: docker run -d -p 1025:1025 mailhog/mailhog)

# ============================================================================
# ASSINATURA DIGITAL (Web PKI / SERPRO)
# ============================================================================

# Endpoints do assinador SERPRO (WebSocket)
# Já configurados em svelte.config.js, mas deixe aqui para referência
# SERPRO_ASSINADOR_URL=https://assinador-desktop.serpro.gov.br:65166

# ============================================================================
# MONITORAMENTO (Sentry)
# ============================================================================

# DSN do Sentry para relatório de erros
# Opcional — se vazio, erros só são logados no console
SENTRY_DSN=https://seu-key@sentry.io/seu-project-id

# ============================================================================
# LOGGING
# ============================================================================

# Nível de log (debug, info, warn, error)
# Padrão: info
LOG_LEVEL=info

# ============================================================================
# DESENVOLVIMENTO
# ============================================================================

# Use apenas em desenvolvimento local
# NODE_ENV=development
# DEBUG=escalas:*
