# Exemplo de variáveis de ambiente.
# Copie para `.dev.vars` (desenvolvimento local com wrangler) ou configure no
# Dashboard Cloudflare Pages (Settings → Environment variables) em produção.
# NUNCA comite `.env`, `.dev.vars` ou qualquer arquivo com segredos reais.

# ---- Obrigatórias ----

# Bearer token exigido por todos os webhooks de sincronização
# (`/api/webhook/sync-policiais`, `/api/webhook/sync-unidades`, e como camada
# base de `/api/webhook/reset-policiais`). Gere com:
#   openssl rand -hex 32
SYNC_TOKEN=


# ---- Operações destrutivas ----

# Segredo SEPARADO de SYNC_TOKEN, exigido pelo endpoint
# `/api/webhook/reset-policiais` além do próprio SYNC_TOKEN. Fail-closed: se
# não estiver definido, o endpoint retorna 401 para qualquer requisição.
# Mantenha offline e use apenas a partir de máquina conhecida.
#   openssl rand -hex 32
RESET_TOKEN=


# ---- Replay protection dos webhooks (P1.3 da auditoria) ----

# Quando truthy (1/true/yes/on), os webhooks /api/webhook/* rejeitam
# requisições SEM os headers X-Webhook-Timestamp + X-Webhook-Nonce. Default
# (vazio): aceita por compatibilidade durante rollout, mas loga `info`.
# Use APÓS confirmar que o Apps Script já está enviando os headers (ver
# DEPLOY.md → "Replay protection dos webhooks").
WEBHOOK_REPLAY_ENFORCE=


# ---- E-mail (2FA, senhas provisórias, redefinição) ----

# Conta Gmail usada para envio via SMTP (nodemailer). Recomenda-se uma conta
# dedicada de serviço, não conta pessoal.
GMAIL_USER=
# App Password do Gmail (16 caracteres). Não é a senha da conta.
# https://support.google.com/accounts/answer/185833
GMAIL_APP_PASSWORD=


# ---- Admin bootstrap (opcional) ----

# Login + senha do Admin Geral via variáveis de ambiente. Usado para o primeiro
# acesso ao sistema. Após criar o admin no banco, REMOVA estas variáveis do
# ambiente de produção — esta conta pula o 2FA.
ADMIN_GERAL_LOGIN=
ADMIN_GERAL_SENHA=


# ---- Observabilidade (Sentry) ----

# DSN do projeto Sentry (Settings → Client Keys). Sem ela, o handler de
# erros do worker é executado em modo no-op (útil em dev/local). EXIGIDA em
# produção para que falhas 5xx não sejam silenciosamente perdidas.
# Formato: https://<key>@<org>.ingest.sentry.io/<project>
SENTRY_DSN=
# Rótulo do ambiente nos eventos (production, staging, dev). Default: production.
SENTRY_ENVIRONMENT=
# Sample rate para tracing (string parseada como float). Default 0.1.
SENTRY_TRACES_SAMPLE_RATE=0.1


# ---- Integração GISE / Google Apps Script (opcional) ----

# Web App URL do Google Apps Script que grava na aba Base_Equipe (POST JSON).
# Ex.: https://script.google.com/macros/s/AKfy.../exec
GISE_BASE_EQUIPE_WEBHOOK_URL=
# Segredo compartilhado com `ScriptProperties.BASE_EQUIPE_SECRET` na planilha.
# Gere com `openssl rand -hex 32` e configure o mesmo valor dos dois lados.
GISE_BASE_EQUIPE_SECRET=
