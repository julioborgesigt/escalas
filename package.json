{
	"name": "escalas",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"db:migrate": "wrangler d1 execute escalas-db --local --file=./migrations/0001_init.sql",
		"test": "vitest run",
		"test:watch": "vitest"
	},
	"devDependencies": {
		"@sveltejs/adapter-cloudflare": "^7.0.0",
		"@sveltejs/kit": "^2.50.2",
		"@sveltejs/vite-plugin-svelte": "^6.2.4",
		"drizzle-kit": "^0.31.10",
		"svelte": "^5.51.0",
		"svelte-check": "^4.4.2",
		"typescript": "^5.9.3",
		"vite": "^7.3.1",
		"vitest": "^4.1.0",
		"wrangler": "^4.0.0"
	},
	"dependencies": {
		"@skeletonlabs/skeleton": "^4.13.0",
		"@skeletonlabs/skeleton-svelte": "^4.13.0",
		"@tailwindcss/vite": "^4.2.2",
		"docx": "^9.0.0",
		"drizzle-orm": "^0.45.1",
		"jspdf": "^3.0.0",
		"jspdf-autotable": "^5.0.0",
		"sveltekit-superforms": "^2.30.0",
		"tailwindcss": "^4.2.2",
		"xlsx": "^0.18.5",
		"zod": "^4.3.6"
	}
}
