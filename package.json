{
	"name": "escalas",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"db:migrate": "npx tsx scripts/migrate.ts",
		"db:migrate:prod": "npx tsx scripts/migrate.ts --remote",
		"test": "vitest run",
		"test:watch": "vitest",
		"lint": "eslint --max-warnings 0 src/",
		"lint:fix": "eslint --fix src/",
		"format": "prettier --write src/",
		"format:check": "prettier --check src/"
	},
	"devDependencies": {
		"@cloudflare/workers-types": "^4.20260317.1",
		"@eslint/js": "^10.0.1",
		"@playwright/test": "^1.59.1",
		"@sveltejs/adapter-cloudflare": "^7.0.0",
		"@sveltejs/kit": "^2.50.2",
		"@sveltejs/vite-plugin-svelte": "^6.2.4",
		"@types/node-forge": "^1.3.14",
		"drizzle-kit": "^0.31.10",
		"eslint": "^10.2.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.17.0",
		"prettier": "^3.8.1",
		"svelte": "^5.51.0",
		"svelte-check": "^4.4.2",
		"tsx": "^4.21.0",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.58.0",
		"vite": "^7.3.1",
		"vitest": "^4.1.0",
		"wrangler": "^4.0.0"
	},
	"dependencies": {
		"@sentry/cloudflare": "^10.47.0",
		"@signpdf/placeholder-pdf-lib": "^3.3.0",
		"@signpdf/signpdf": "^3.3.0",
		"@skeletonlabs/skeleton": "^4.13.0",
		"@skeletonlabs/skeleton-svelte": "^4.13.0",
		"@tailwindcss/vite": "^4.2.2",
		"@types/nodemailer": "^8.0.0",
		"@types/qrcode": "^1.5.6",
		"@vladmandic/face-api": "^1.7.15",
		"chart.js": "^4.5.1",
		"docx": "^9.0.0",
		"dompurify": "^3.4.0",
		"drizzle-orm": "^0.45.1",
		"jspdf": "^4.2.1",
		"jspdf-autotable": "^5.0.7",
		"node-forge": "^1.3.3",
		"nodemailer": "^8.0.4",
		"pdf-lib": "^1.17.1",
		"qrcode": "^1.5.4",
		"tailwindcss": "^4.2.2",
		"web-pki": "^2.18.0",
		"xlsx": "^0.18.5",
		"zod": "^4.3.6"
	}
}
