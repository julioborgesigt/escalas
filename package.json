{
	"name": "escalas",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"engines": {
		"node": ">=22.0.0"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"db:migrate": "npx tsx scripts/migrate.ts",
		"db:migrate:prod": "npx tsx scripts/migrate.ts --remote",
		"users:set-default-password": "npx tsx scripts/set-default-password-all-users.ts --yes",
		"users:set-default-password:prod": "npx tsx scripts/set-default-password-all-users.ts --remote --yes",
		"users:clear-passwords-non-admins": "npx tsx scripts/clear-passwords-non-admins.ts --yes",
		"users:clear-passwords-non-admins:prod": "npx tsx scripts/clear-passwords-non-admins.ts --remote --yes",
		"test": "vitest run",
		"test:watch": "vitest",
		"lint": "eslint src/",
		"lint:strict": "eslint --max-warnings 0 src/",
		"lint:fix": "eslint --fix src/",
		"format": "prettier --write src/",
		"format:check": "prettier --check src/"
	},
	"devDependencies": {
		"@cloudflare/workers-types": "^4.20260518.1",
		"@eslint/js": "^10.0.1",
		"@playwright/test": "^1.60.0",
		"@sveltejs/adapter-cloudflare": "^7.0.0",
		"@sveltejs/kit": "^2.50.2",
		"@sveltejs/vite-plugin-svelte": "^6.2.4",
		"@types/node-forge": "^1.3.14",
		"drizzle-kit": "^0.31.10",
		"eslint": "^10.4.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.17.1",
		"prettier": "^3.8.3",
		"rollup-plugin-visualizer": "^5.14.0",
		"svelte": "^5.55.8",
		"svelte-check": "^4.4.8",
		"tsx": "^4.22.2",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.59.3",
		"vite": "^7.3.1",
		"vitest": "^4.1.6",
		"wrangler": "^4.92.0"
	},
	"overrides": {
		"cookie": "^0.7.2",
		"@esbuild-kit/core-utils": {
			"esbuild": "^0.25.0"
		}
	},
	"dependencies": {
		"@fontsource/inter": "^5.2.8",
		"@fontsource/outfit": "^5.2.8",
		"@sentry/cloudflare": "^10.47.0",
		"@signpdf/placeholder-pdf-lib": "^3.3.0",
		"@signpdf/signpdf": "^3.3.0",
		"@signpdf/utils": "^3.3.0",
		"@skeletonlabs/skeleton": "^4.13.0",
		"@skeletonlabs/skeleton-svelte": "^4.13.0",
		"@tailwindcss/vite": "^4.2.2",
		"@types/nodemailer": "^8.0.0",
		"@types/qrcode": "^1.5.6",
		"@vladmandic/face-api": "^1.7.15",
		"chart.js": "^4.5.1",
		"docx": "^9.0.0",
		"drizzle-orm": "^0.45.1",
		"exceljs": "^4.4.0",
		"jspdf": "^4.2.1",
		"jspdf-autotable": "^5.0.7",
		"lucide-svelte": "^1.0.1",
		"node-forge": "^1.3.3",
		"nodemailer": "^8.0.7",
		"pdf-lib": "^1.17.1",
		"qrcode": "^1.5.4",
		"tailwindcss": "^4.2.2",
		"web-pki": "^2.18.0",
		"zod": "^4.3.6"
	}
}
