.wrangler
/.svelte-kit
/build

# OS
.DS_Store
Thumbs.db

# Env
.env
.env.*
!.env.example
!.env.test
# NÃO adicionar `!.dev.vars` aqui: `.dev.vars` não casa com `.env.*`, então a
# negação não libera nada — só cria a armadilha de DESFAZER o ignore da linha
# abaixo, que é o arquivo com SYNC_TOKEN, RESET_TOKEN, CPF_ENCRYPTION_KEY e
# PASSWORD_PEPPER. Hoje o ignore vence só porque vem depois.

# Vite
vite.config.js.timestamp-*
vite.config.ts.timestamp-*

# Variaveis de ambiente locais (NUNCA comitar)
.dev.vars

# Config local do Claude Code (permissões por máquina — não versionar)
.claude/settings.local.json

# Gerados automaticamente
worker-configuration.d.ts
tsconfig.tsbuildinfo
bundle-stats.html
eslint.json
fallow_deadcode.txt
fallow_results.json
knip_output*.txt
tsc_output.txt

# Selo institucional: bloqueia a CHAVE PRIVADA (nunca versionar). O certificado
# PÚBLICO (selo-institucional.cert.pem) PODE ser versionado p/ conferência de terceiros.
selo-institucional.key.pem
*.key.pem

# Dumps de banco — NUNCA versionar (contém dados pessoais)
dump.sql
*.backup
backup/

# Drizzle migrations (geradas por drizzle-kit)
/drizzle

# Lixo local de reinstalação/npm (native addon, cópia de node_modules)
.tmp-*/

# Playwright — artefatos de execução local (screenshots, traces, last-run)
test-results/
playwright-report/

DPI_DATA_PLANTÃO_DADOS.xlsx
AutomacaoEquipeExtras.gs
DPI_DATA_PLANTÃO_DADOS.xlsx

# Valores de secrets de staging gerados localmente (script set-staging-secrets.sh).
# A chave privada do selo já é coberta por *.key.pem acima; o cert público é versionado.
/staging-secrets.generated.txt
coverage/

# Artefatos da CA de TESTE da suíte E2E (chaves regeneradas a cada execução)
e2e/ca-teste/artefatos/

# Token de webhook publicado pelo servidor E2E (gitignored)
e2e/.webhook-token
